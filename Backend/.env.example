# Server Configuration
PORT=1234

# MongoDB Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/coinsafe

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# Blockchain Configuration
LISK_RPC_URL=https://rpc.api.lisk.com
PRIVATE_KEY=your_private_key_here
CONTRACT_ADDRESS=your_contract_address_here
RELAYER_PRIVATE_KEY=your_relayer_private_key_here
FAUCET_ADDRESS=your_faucet_address_here
SAFU_TOKEN_ADDRESS=your_safu_token_address_here

# Fonbnk Configuration
FONBNK_SIGNATURE_SECRET=your_fonbnk_signature_secret_here
FONBNK_SOURCE=your_fonbnk_source_here
FONBNK_ENVIRONMENT=sandbox

# Email Configuration
service=gmail
user=your_email@gmail.com
mailPassword=your_app_password_here
